FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/StyleCart.ApiGateway/StyleCart.ApiGateway.csproj", "src/StyleCart.ApiGateway/"]
RUN dotnet restore "src/StyleCart.ApiGateway/StyleCart.ApiGateway.csproj"

COPY . .
WORKDIR "/src/src/StyleCart.ApiGateway"
RUN dotnet publish "StyleCart.ApiGateway.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
ENV RUNNING_IN_CONTAINER=true
EXPOSE 8080
ENTRYPOINT ["dotnet", "StyleCart.ApiGateway.dll"]