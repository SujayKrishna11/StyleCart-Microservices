FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/StyleCart.UserService/StyleCart.UserService.csproj", "src/StyleCart.UserService/"]
RUN dotnet restore "src/StyleCart.UserService/StyleCart.UserService.csproj"

COPY . .
WORKDIR "/src/src/StyleCart.UserService"
RUN dotnet publish "StyleCart.UserService.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "StyleCart.UserService.dll"]