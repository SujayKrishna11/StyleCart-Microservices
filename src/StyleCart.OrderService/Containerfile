FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/StyleCart.OrderService/StyleCart.OrderService.csproj", "src/StyleCart.OrderService/"]
RUN dotnet restore "src/StyleCart.OrderService/StyleCart.OrderService.csproj"

COPY . .
WORKDIR "/src/src/StyleCart.OrderService"
RUN dotnet publish "StyleCart.OrderService.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "StyleCart.OrderService.dll"]